# Plantilla de configuracion de produccion. Copiar a backend/.env, completar
# y proteger con chmod 600. Nunca versionar el archivo real.

ENV=prod
DATABASE_URL=sqlite:////var/lib/aerg/app.db

# Origen exacto del frontend. Nunca usar *.
CORS_ORIGINS=https://tu-dominio.example

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Debe coincidir con VITE_API_TOKEN del frontend.
AUTH_TOKEN=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Debe ser <= al limite de cuerpo configurado en el proxy inverso.
MAX_UPLOAD_MB=10
MAX_SUBMISSION_CHARS=200000
UPLOAD_DIR=/var/lib/aerg/uploads

# Solo si se registra una integracion LTI1_3 (Nivel 2).
LTI_ISSUER=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_JWKS_URL=
LTI_AUTH_LOGIN_URL=
