ENV=dev
DATABASE_URL=sqlite:///./app.db

CORS_ORIGINS=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

MAX_UPLOAD_MB=10
MAX_SUBMISSION_CHARS=200000
AUTH_TOKEN=prototipo-dev-token
UPLOAD_DIR=uploads

# Sesion del docente tras un launch LTI 1.3 (RS-01). Usa un secreto largo y aleatorio.
SESSION_SECRET=cambia-este-secreto-de-sesion
SESSION_TTL_HOURS=8
FRONTEND_URL=http://localhost:5173

# Solo si LMSIntegration.type == LTI1_3 (Nivel 2)
LTI_ISSUER=
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_JWKS_URL=
LTI_AUTH_LOGIN_URL=
LTI_TOKEN_URL=
# Llave privada RSA de la herramienta (PEM). Debe vivir FUERA del repositorio.
LTI_TOOL_PRIVATE_KEY_PATH=
